# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.sample

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# next-sitemap output (postbuild). Only the numbered file is ignored: it holds
# the URLs and tracks the package index, so committing it churns 200-odd lines
# whenever anyone runs a build. Its siblings are generated too but derive purely
# from this config rather than from the index - sitemap.xml just names this
# file, robots.txt just points at sitemap.xml - so both reproduce byte for byte
# and stay committed, leaving crawlers something to follow even from a build
# that skips postbuild.
/public/sitemap-*.xml

# Generated by scripts/scan-api-usage.mjs at prebuild, from the archives in
# ../packages and Mudlet's published function list.
/app/lib/generated
